<?xml version="1.0" encoding="utf-8"?>
<!--
  ATW.exe ist gegen .NET Framework 2.0 gebaut (v2.0.50727). Auf Windows 10
  und 11 fehlt dieser Laufzeitzweig ab Werk; ohne diese Datei bleibt das
  Programm mit der Aufforderung stehen, ".NET Framework 3.5" nachzuinstallieren.

  Die Reihenfolge der supportedRuntime-Eintraege ist die Suchreihenfolge:
  ist der urspruengliche 2.0-Zweig vorhanden, laeuft das Werkzeug wie
  gehabt darauf; sonst uebernimmt die 4.x-Laufzeit. Das ist unbedenklich,
  weil ATW.exe und alle mitgelieferten Bibliotheken reines IL ohne
  gemischten nativen Code sind (COR20-Flag ILONLY).
-->
<configuration>
  <startup>
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <!--
      Erlaubt den Start von einem Netzlaufwerk und von Dateien, die
      Windows nach dem Herunterladen als "aus dem Internet" markiert hat.
    -->
    <loadFromRemoteSources enabled="true" />
    <!--
      Ohne diese Zeile prueft die 2.0-Laufzeit beim Start die
      Authenticode-Sperrlisten der Baugruppen. Auf einem Rechner ohne
      Internet dauert das bis zu einer halben Minute.
    -->
    <generatePublisherEvidence enabled="false" />
  </runtime>
</configuration>
